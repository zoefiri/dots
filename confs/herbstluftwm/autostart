hc() {
    herbstclient "$@"
}

###############
# reload herb #
######################
hc emit_hook reload  #
sleep 1              #
######################
#  chainload confs   #
######################
hc spawn /home/zoe/.config/herbstluftwm/binds
hc spawn /home/zoe/.config/herbstluftwm/theme
hc spawn /home/zoe/.config/herbstluftwm/start

################
# xinput props #
################
# sets disable mouse while typing to false
xinput set-prop 10 305 0

#########
# rules #
#########
hc unrule -F
hc rule focus=on # normally focus new clients
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' pseudotile=on
hc rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' manage=off
hc set tree_style '╾│ ├└╼─┐'
## panes 

/home/zoe/.config/herbstluftwm/guistart

#################
# monitor stuff #
#################
hc unlock
hc detect_monitors
sleep 1
hc pad 0 5 5 5 95
