mpd_host = "127.0.0.1"
mpd_port = "6600"

# Display ..
song_status_format = "$(64)%a $6$b> $(31)%t $6$b> $2%b"
#song_list_format = "$(63){%a ⚝$(63) %t$/r$R}|{%f}"
song_list_format = "$5{%a $2⚝$3 %t $/r$/u$R$b$8%l$/b  }|{$1%f$/r}"

song_columns_list_format = "(20)[61]'⚝' (20)[61]{a} (20)[4]{t}"
playlist_display_mode = "classic" (classic/columns)
current_item_inactive_column_suffix = "aaaa"

# Now Playing ..
now_playing_prefix = "$b$(64)"
now_playing_suffix = "$/b"
current_item_suffix = "$/r$(end)"
current_item_prefix = "$(64)$r"

# Playlist ..
browser_playlist_prefix = "$2 ♥ $0 "

# Delays .. 
playlist_disable_highlight_delay = "1"
message_delay_time= "1"

# Progress Bar ..
#progressbar_look = "━━━"
progressbar_look = "─╼ "
progressbar_color = "red"
progressbar_elapsed_color = "magenta"

# Colors ..
colors_enabled = "yes"
empty_tag_color = "red"
statusbar_color = "cyan"
state_line_color = "black"
state_flags_color = "green"
main_window_color = "green" 
header_window_color = "black"
statusbar_time_color = "blue"

# Misc ..   
display_bitrate = "no"
autocenter_mode = "yes"
centered_cursor = "yes"
titles_visibility = "no"
statusbar_visibility = "yes"
empty_tag_marker=" -- ‼ -- " 
header_visibility = "no"
display_remaining_time = "no"
ask_before_clearing_playlists = "no"
discard_colors_if_item_is_selected = "yes"

# Visualizer ..
visualizer_in_stereo = "yes"
visualizer_output_name = "Pipe"
visualizer_type = "wave_filled" (spectrum/wave/wave_filled/ellipse)
visualizer_color = "3"
visualizer_look = "✖✖"

# Lyrics ..
lyrics_fetchers = azlyrics, musixmatch, sing365, metrolyrics, justsomelyrics, jahlyrics, plyrics, tekstowo, zeneszoveg, internet

execute_on_song_change="~/.ncmpcpp/ncmpcpp-ueberzug/ncmpcpp_cover_art.sh"
