# font
font-family = Monaspace Neon Var
font-size = 16
font-variation = "wght=600"
font-variation-bold = "wght=1200"
font-feature = -calt, -liga, -dlig
# adjust-cell-width = -25%

# window appearance
window-padding-x = 2
window-decoration = none
confirm-close-surface = false

# theming
theme = mothdust
background-opacity = 0.77
background-blur = true
custom-shader = /home/zoe/.config/ghostty/smear.glsl
alpha-blending = linear-corrected
bold-is-bright = false
cursor-style = block
cursor-opacity = 0.1
